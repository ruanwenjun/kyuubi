        </mxCell>
        <mxCell id="19" value="Future.get() waits&lt;br/&gt;Keeps locks A + B" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#fff1f0;strokeColor=#c94b46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="493" width="250" height="70" />
        </mxCell>
        <mxCell id="20" value="socketRead0 waits&lt;br/&gt;No response deadline" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#fff1f0;strokeColor=#c94b46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="493" width="250" height="70" />
        </mxCell>
        <mxCell id="21" value="Request received;&lt;br/&gt;response never returns" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#fff1f0;strokeColor=#c94b46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="585" y="493" width="250" height="70" />
        </mxCell>
        <mxCell id="22" value="2. Waiting spreads to cleanup" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="595" width="750" height="30" />
        </mxCell>
        <mxCell id="23" value="fetchResults / fetchQueryLog&lt;br/&gt;Waits for client lock B" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#fff1f0;strokeColor=#c94b46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="647" width="250" height="76" />
        </mxCell>
        <mxCell id="24" value="B is owned by the&lt;br/&gt;cancellation handler" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#a3a3a3;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="737" width="250" height="58" />
        </mxCell>
        <mxCell id="25" value="Expired-operation cleanup&lt;br/&gt;calls operation.close()&lt;br/&gt;Waits for operation lock A" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;rounded=1;arcSize=8;whiteSpace=wrap;spacing=12;align=left;verticalAlign=middle;fillColor=#fff1f0;strokeColor=#c94b46;" vertex="1" parent="1">
