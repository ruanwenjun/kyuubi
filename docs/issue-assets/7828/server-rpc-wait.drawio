        <mxCell id="28" value="Impact" style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="950" width="130" height="32" />
        </mxCell>
        <mxCell id="29" value="Same-client RPCs wait on B. The single timeout-checker waits on A and cannot check other sessions." style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="175" y="948" width="1210" height="44" />
        </mxCell>
        <mxCell id="30" value="Local CANCELED does not confirm engine cancellation or session closure." style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="175" y="998" width="1210" height="30" />
        </mxCell>
        <mxCell id="31" value="The diagram ends while waits are unresolved; no cleanup success is implied." style="html=1;fontFamily=Helvetica;fontSize=16;fontColor=#262626;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
